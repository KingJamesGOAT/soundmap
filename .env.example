# Port d'écoute du serveur HTTP Express
PORT=3000

# URL de connexion à la base de données MongoDB (ex: MongoDB Atlas ou instance locale)
# Format standard : mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
DATABASE_URL=mongodb://127.0.0.1:27017/soundmap

# Clé secrète utilisée pour signer et vérifier les JSON Web Tokens (JWT)
# Générer une chaîne aléatoire et robuste en production
JWT_SECRET=super_secret_key_soundmap_development_123456
